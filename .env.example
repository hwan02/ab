# 복사해서 .env.local 로 쓰세요. 실제 값은 커밋하지 마세요.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_ADMIN_EMAIL=
SLACK_WEBHOOK_URL=
GOOGLE_TRANSLATE_API_KEY=

# 에어비앤비 알림 메일 수집 (공동호스트 계정의 카카오메일)
# 카카오메일 웹 > 환경설정 > IMAP/POP3 > IMAP 사용 켜기. 2단계 인증 시 앱 비밀번호 사용.
KAKAO_IMAP_USER=
KAKAO_IMAP_PASSWORD=
KAKAO_IMAP_HOST=imap.kakao.com
KAKAO_IMAP_PORT=993

# /api/airbnb/inbox/sync 보호용. Vercel 이 cron 호출 시 자동으로 Authorization: Bearer 로 붙여 보냄.
CRON_SECRET=

# 답장 초안 생성 (Vercel AI Gateway). 로컬에서만 필요, Vercel 배포는 OIDC 로 자동 인증.
# vercel.com → 팀 → AI → API Keys 에서 발급.
AI_GATEWAY_API_KEY=
# 기본 anthropic/claude-opus-5.5. 바꾸려면 설정.
AIRBNB_DRAFT_MODEL=

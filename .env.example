# 복사해서 .env.local 로 쓰세요. 실제 값은 커밋하지 마세요.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_ADMIN_EMAIL=
SLACK_WEBHOOK_URL=
GOOGLE_TRANSLATE_API_KEY=

# 에어비앤비 알림 메일 수집 (공동호스트 계정의 카카오메일)
# 카카오메일 웹 > 환경설정 > IMAP/POP3 > IMAP 사용 켜기. 2단계 인증 시 앱 비밀번호 사용.
KAKAO_IMAP_USER=
KAKAO_IMAP_PASSWORD=
KAKAO_IMAP_HOST=imap.kakao.com
KAKAO_IMAP_PORT=993

# /api/airbnb/inbox/sync 보호용. Vercel 이 cron 호출 시 자동으로 Authorization: Bearer 로 붙여 보냄.
# Vercel Hobby 는 크론이 하루 1회(vercel.json)라, 5분 수집은 외부 스케줄러(cron-job.org 등)에서
#   GET https://<도메인>/api/airbnb/inbox/sync  헤더 Authorization: Bearer <CRON_SECRET>  를 5분마다 호출하게 설정한다.
CRON_SECRET=

# 답장 초안 생성 (Vercel AI Gateway). 로컬에서만 필요, Vercel 배포는 OIDC 로 자동 인증.
# vercel.com → 팀 → AI → API Keys 에서 발급.
AI_GATEWAY_API_KEY=
# 기본 anthropic/claude-opus-5.5. 바꾸려면 설정.
AIRBNB_DRAFT_MODEL=

# 메일 회신 발송 (카카오 SMTP). 수집 계정과 같은 KAKAO_IMAP_USER/PASSWORD 를 쓴다.
# 카카오메일 웹 > 환경설정 > IMAP/POP3 > POP3/SMTP 사용 켜기.
KAKAO_SMTP_HOST=smtp.kakao.com
KAKAO_SMTP_PORT=465

# 가이드 페이지에 표시할 포포톡 공동호스트 계정 이메일 (호스트가 에어비앤비에서 초대할 주소)
NEXT_PUBLIC_POPOTALK_COHOST_EMAIL=
